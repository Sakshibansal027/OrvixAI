{
  "name": "orvix",
  "version": "0.1.0",
  "private": true,
  "description": "ORVIX autonomous customer support and root-cause engine",
  "scripts": {
    "dev": "tsx watch server/src/server.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "client:dev": "pnpm --dir client dev",
    "client:build": "pnpm --dir client build",
    "build": "tsc -p server/tsconfig.json",
    "start": "node server/dist/server.js",
    "seed": "tsx server/src/data/seed.ts",
    "typecheck": "tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "mongoose": "^8.18.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.2"
  }
}
